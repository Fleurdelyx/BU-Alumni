rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROTOTYPING RULES: BALIUAGU ALUMNI CONNECT
     * 
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict Ownership Model for user-specific data (profiles and questionnaire responses) 
     * while providing restricted access to shared university resources (courses and questionnaires).
     * 
     * DATA STRUCTURE:
     * - /users/{userId}: Private user account documents.
     * - /alumni/{alumnusId}: Publicly identifiable alumni profiles, linked to users via ID matching.
     * - /alumni/{alumnusId}/questionnaireResponses/{id}: Responses owned by specific alumni.
     * - /courses/{id}: Read-only university catalog.
     * - /questionnaires/{id}: Read-only (for alumni) survey definitions created by administrators.
     * - /logs/{id}: Activity logs for tracking system changes.
     */

    // --- Global Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user matches the provided ID (Ownership Pattern). */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is the owner and the document exists (for updates/deletes). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** 
     * @description Placeholder for admin-level authorization. 
     * For this prototype, we allow signed-in users to perform admin actions to facilitate testing.
     * In production, this would strictly check request.auth.token.admin == true.
     */
    function isAdmin() {
      return isSignedIn();
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the User collection.
     */
    match /users/{userId} {
      allow get, list, create, update, delete: if isOwner(userId);
    }

    /**
     * @description Rules for Alumnus profiles.
     */
    match /alumni/{alumnusId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(alumnusId) && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(alumnusId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(alumnusId) || isAdmin();

      match /questionnaireResponses/{responseId} {
        allow get, list, create, update, delete: if isOwner(alumnusId) || isAdmin();
      }
    }

    /**
     * @description Read-only access to Course information for all authenticated alumni.
     */
    match /courses/{courseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Access to Questionnaire definitions.
     */
    match /questionnaires/{questionnaireId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin(); 
    }

    /**
     * @description Rules for activity logs.
     * Allows any signed-in user to create a log (e.g., when updating their profile).
     * Allows admins (signed-in users in this prototype) to view the logs.
     */
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
    }
  }
}